{
  "expo": {
    "name": "Vigil",
    "slug": "vigil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vigil",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2B393C"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSUserNotificationUsageDescription": "Vigil sends mindfulness check-ins throughout your day."
      }
    },
    "android": {
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "package": "com.valeraplushkin.vigil",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-notifications",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "23718c7c-fdd0-4246-b7fd-54a21c86dd01"
      }
    }
  }
}
